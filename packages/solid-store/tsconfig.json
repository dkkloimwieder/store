{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    // Match the runtime the tests execute under: vite-plugin-solid injects the
    // browser/development conditions in test mode, and solid-js maps the bare
    // node condition to an inert server build.
    "customConditions": ["browser", "development"],
    "paths": {
      "@tanstack/store": ["../store/src"]
    }
  },
  "include": ["src", "tests", "eslint.config.js", "vitest.config.ts"]
}
